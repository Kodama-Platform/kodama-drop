# Skip password / KSP encryption and save workbooks in localStorage (UI polish).
# On by default in `npm run dev`. Set false to restore the encrypted place flow.
# In production builds, set VITE_PLAINTEXT_MODE=true explicitly to enable.
VITE_PLAINTEXT_MODE=true

VITE_DONATE_URL="https://ko-fi.com/"
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
